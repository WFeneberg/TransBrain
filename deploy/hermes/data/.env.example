# Copy to .env — or simply save the settings once in the TransBrain central administration
# (Verwaltung → KI-Assistent), which creates and maintains this file.
#
# Hermes re-reads this file at the start of every turn: changes apply without a restart.
# Infrastructure wiring (API_SERVER_*, TRANSBRAIN_API_BASE_URL, TRANSBRAIN_OIDC_TOKEN_URL,
# TRANSBRAIN_AGENT_CLIENT_ID/SECRET) is injected by the AppHost / docker-compose and does
# not belong here.

# --- Assistant switches (read by the TransBrain API before every proxied chat turn) ---
TRANSBRAIN_ASSISTANT_ENABLED=false
# Provider id: openrouter | openai-api | anthropic | gemini | deepseek | xai | custom
TRANSBRAIN_ASSISTANT_PROVIDER=openrouter
# Model id in the provider's own naming, e.g. anthropic/claude-sonnet-4.5 on OpenRouter.
TRANSBRAIN_ASSISTANT_MODEL=
# true = the agent may execute write actions through the transbrain-api skill on its own.
TRANSBRAIN_ASSISTANT_AUTONOMY=false

# --- LLM provider credentials (exactly one is needed for the selected provider) ---
OPENROUTER_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GOOGLE_API_KEY=
#DEEPSEEK_API_KEY=
#XAI_API_KEY=
# Custom OpenAI-compatible endpoint (provider "custom" uses OPENAI_API_KEY + this base URL):
#OPENAI_BASE_URL=

HERMES_TIMEZONE=Europe/Berlin
