<Project>
  <!-- Scoped to .NET projects. The two frontends are .esproj (Microsoft.VisualStudio.JavaScript.Sdk),
       which has no compiler and no target framework of its own; handing it TargetFramework=net10.0
       makes NuGet restore it as if it were a .NET assembly, and MSBuildTreatWarningsAsErrors turns
       the SDK's own npm-related warnings into build failures. Neither property means anything for a
       project whose "build" is `npm run build`. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' != '.esproj'">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- TreatWarningsAsErrors only covers compiler warnings; MSBuild-level warnings (e.g. an EF
         Core package version skew, an MSB3277 assembly-version conflict) are a separate class
         and slipped through earlier without this. -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
